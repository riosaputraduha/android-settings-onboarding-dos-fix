From e417a8c9b20d11f8e91029384756b1a23c4d5e6f Mon Sep 17 00:00:00 2001
From: Security Remediation Team <security@android.com>
Date: Wed, 21 Oct 2026 15:40:00 +0000
Subject: [PATCH] Fix F-03: Mitigate DoS and unbounded state allocation in OnboardingTaskManager

- Enforce caller signature verification before any state allocation.
- Prevent unverified tokens from writing Failure state to OnboardingTaskStateManager.
- Enforce strict length limits on COMPONENT and NODE_ID token strings.
- Implement bounded LruCache with TTL eviction in OnboardingTaskStateManager.
- Clamp delayFor duration and enforce per-UID concurrency limits in DiagnosisProviderTask.

Bug: F-03
Test: Verified with long-key heap saturation and unbounded delay PoC tests.
---
 .../onboarding/OnboardingTaskManagerService.kt     | 58 ++++++++++++++++++++--
 .../onboarding/OnboardingTaskStateManager.kt       | 49 +++++++++++++++---
 .../settings/onboarding/tasks/DiagnosisProviderTask.kt | 32 +++++++++++-
 3 files changed, 126 insertions(+), 13 deletions(-)

diff --git a/src/com/android/settings/onboarding/OnboardingTaskManagerService.kt b/src/com/android/settings/onboarding/OnboardingTaskManagerService.kt
index 8a1b2c3..4d5e6f7 100644
--- a/src/com/android/settings/onboarding/OnboardingTaskManagerService.kt
+++ b/src/com/android/settings/onboarding/OnboardingTaskManagerService.kt
@@ -16,11 +16,13 @@

 package com.android.settings.onboarding

+import android.content.Context
 import android.content.pm.PackageManager
 import android.os.Binder
 import android.os.Process
 import android.util.Log
 import com.android.settings.onboarding.model.TaskToken
+import java.lang.IllegalArgumentException
+import java.lang.SecurityException

 class OnboardingTaskManagerService(
     private val context: Context,
@@ -29,22 +31,68 @@ class OnboardingTaskManagerService(
 ) : IOnboardingTaskManager.Stub() {

     companion object {
         private const val TAG = "OnboardingTaskManager"
+        private const val MAX_IDENTIFIER_LENGTH = 256
+        private const val SETUPWIZARD_PACKAGE = "com.google.android.setupwizard"
     }

+    private fun enforceCallerIdentity(callerPackage: String) {
+        val callingUid = Binder.getCallingUid()
+        if (callingUid == Process.SYSTEM_UID || callingUid == Process.ROOT_UID) {
+            return
+        }
+
+        val pm = context.packageManager
+        val packageUid = try {
+            pm.getPackageUid(callerPackage, 0)
+        } catch (e: PackageManager.NameNotFoundException) {
+            throw SecurityException("Caller package $callerPackage is not installed on the system.")
+        }
+
+        if (packageUid != callingUid) {
+            throw SecurityException("Declared caller package $callerPackage does not match calling UID $callingUid.")
+        }
+
+        // Enforce signature match with platform or recognized setupwizard package
+        val isPlatformSigned = pm.checkSignatures(Process.SYSTEM_UID, callingUid) == PackageManager.SIGNATURE_MATCH
+        val isSetupWizard = try {
+            callerPackage == SETUPWIZARD_PACKAGE &&
+                pm.checkSignatures(callerPackage, SETUPWIZARD_PACKAGE) == PackageManager.SIGNATURE_MATCH
+        } catch (e: Exception) {
+            false
+        }
+
+        if (!isPlatformSigned && !isSetupWizard) {
+            throw SecurityException("Caller UID $callingUid is unauthorized to access OnboardingTaskManager.")
+        }
+    }
+
     override fun startTask(token: TaskToken, callerPackage: String) {
-        // Vulnerable: Package name accepted without strict signature check before allocation
-        createAndInitTask(token)
+        // 1. Fail-fast caller authorization before touching any state
+        enforceCallerIdentity(callerPackage)
+
+        // 2. Validate input token string boundaries
+        val component = token.component
+        val nodeId = token.nodeId
+        if (component.length > MAX_IDENTIFIER_LENGTH || nodeId.length > MAX_IDENTIFIER_LENGTH) {
+            throw IllegalArgumentException("Token identifiers exceed maximum allowed length of $MAX_IDENTIFIER_LENGTH characters.")
+        }
+
+        // 3. Resolve token against registered nodes before initializing state
+        val node = nodeRegistry.findNode(token)
+        if (node == null) {
+            Log.w(TAG, "Rejecting unregistered task token: $component / $nodeId")
+            throw IllegalArgumentException("Task token does not match any registered node.")
+        }
+
+        createAndInitTask(token, node)
     }

-    private fun createAndInitTask(token: TaskToken) {
-        val node = nodeRegistry.findNode(token)
-        if (node == null) {
-            taskStateManager.putState(token, TaskState.Failure("Task cannot be found."))
-            return
-        }
+    private fun createAndInitTask(token: TaskToken, node: OnboardingNode) {
         val task = taskFactory.create(node)
         taskStateManager.registerTask(token, task)
         task.run()
     }
 }
diff --git a/src/com/android/settings/onboarding/OnboardingTaskStateManager.kt b/src/com/android/settings/onboarding/OnboardingTaskStateManager.kt
index b2c3d4e..5e6f7a8 100644
--- a/src/com/android/settings/onboarding/OnboardingTaskStateManager.kt
+++ b/src/com/android/settings/onboarding/OnboardingTaskStateManager.kt
@@ -16,16 +16,51 @@

 package com.android.settings.onboarding

+import android.os.SystemClock
+import android.util.LruCache
 import com.android.settings.onboarding.model.TaskState
 import com.android.settings.onboarding.model.TaskToken
-import java.util.concurrent.ConcurrentHashMap

-class OnboardingTaskStateManager {
-    // Vulnerable: Unbounded map holding arbitrary caller-supplied tokens indefinitely
-    private val stateMap = ConcurrentHashMap<String, TaskState>()
+class OnboardingTaskStateManager(
+    maxCapacity: Int = MAX_STATE_CAPACITY
+) {
+    companion object {
+        private const val MAX_STATE_CAPACITY = 100
+        private const val TTL_MILLIS = 10 * 60 * 1000L // 10 minutes TTL
+    }
+
+    private data class TimestampedState(
+        val state: TaskState,
+        val timestamp: Long = SystemClock.elapsedRealtime()
+    )
+
+    // Bounded LRU cache guarding against memory saturation
+    private val lruCache = object : LruCache<String, TimestampedState>(maxCapacity) {
+        override fun entryRemoved(evicted: Boolean, key: String?, oldValue: TimestampedState?, newValue: TimestampedState?) {
+            if (evicted && oldValue?.state is AutoCloseable) {
+                (oldValue.state as AutoCloseable).close()
+            }
+        }
+    }

     private fun toKey(token: TaskToken): String = "${token.component}:${token.nodeId}"

     fun putState(token: TaskToken, state: TaskState) {
-        stateMap[toKey(token)] = state
+        synchronized(lruCache) {
+            lruCache.put(toKey(token), TimestampedState(state))
+        }
     }

     fun getState(token: TaskToken): TaskState? {
-        return stateMap[toKey(token)]
+        synchronized(lruCache) {
+            val entry = lruCache.get(toKey(token)) ?: return null
+            if (SystemClock.elapsedRealtime() - entry.timestamp > TTL_MILLIS) {
+                lruCache.remove(toKey(token))
+                return null
+            }
+            return entry.state
+        }
     }

     fun close() {
-        stateMap.clear()
+        synchronized(lruCache) {
+            lruCache.evictAll()
+        }
     }
 }
diff --git a/src/com/android/settings/onboarding/tasks/DiagnosisProviderTask.kt b/src/com/android/settings/onboarding/tasks/DiagnosisProviderTask.kt
index c3d4e5f..6a7b8c9 100644
--- a/src/com/android/settings/onboarding/tasks/DiagnosisProviderTask.kt
+++ b/src/com/android/settings/onboarding/tasks/DiagnosisProviderTask.kt
@@ -16,11 +16,16 @@

 package com.android.settings.onboarding.tasks

+import android.os.Binder
 import kotlinx.coroutines.delay
 import java.time.Duration
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger

 class DiagnosisProviderTask(
+    private val callingUid: Int = Binder.getCallingUid(),
     private val delayFor: Duration = Duration.ZERO
 ) : RunnableTask {

     companion object {
+        private const val MAX_DELAY_MILLIS = 60_000L // Upper bound: 60 seconds
+        private const val MAX_CONCURRENT_PER_UID = 5
+        private val activeTasksByUid = ConcurrentHashMap<Int, AtomicInteger>()
     }

     override suspend fun runTask() {
-        // Vulnerable: Arbitrary duration delay without bound
-        delay(delayFor.toMillis())
+        val counter = activeTasksByUid.computeIfAbsent(callingUid) { AtomicInteger(0) }
+        if (counter.get() >= MAX_CONCURRENT_PER_UID) {
+            throw IllegalStateException("Maximum concurrent diagnosis tasks exceeded for UID: $callingUid")
+        }
+
+        counter.incrementAndGet()
+        try {
+            // Clamp delay duration between 0 and 60 seconds
+            val clampedDelay = delayFor.toMillis().coerceIn(0L, MAX_DELAY_MILLIS)
+            delay(clampedDelay)
+            executeDiagnostics()
+        } finally {
+            counter.decrementAndGet()
+        }
     }

     private fun executeDiagnostics() {
         // Perform diagnostic checks
     }
 }
