@@ -0,0 +1,37 @@
+package com.android.settings.onboarding
+
+import android.os.SystemClock
+import android.util.LruCache
+
+class OnboardingTaskStateManager(
+    maxCapacity: Int = MAX_STATE_CAPACITY
+) {
+    companion object {
+        private const val MAX_STATE_CAPACITY = 100
+        private const val TTL_MILLIS = 10 * 60 * 1000L // 10 minutes
+    }
+
+    private data class TimestampedState(
+        val state: String,
+        val timestamp: Long = SystemClock.elapsedRealtime()
+    )
+
+    private val lruCache = LruCache<String, TimestampedState>(maxCapacity)
+
+    fun putState(key: String, state: String) {
+        synchronized(lruCache) {
+            lruCache.put(key, TimestampedState(state))
+        }
+    }
+
+    fun getState(key: String): String? {
+        synchronized(lruCache) {
+            val entry = lruCache.get(key) ?: return null
+            if (SystemClock.elapsedRealtime() - entry.timestamp > TTL_MILLIS) {
+                lruCache.remove(key)
+                return null
+            }
+            return entry.state
+        }
+    }
+}
