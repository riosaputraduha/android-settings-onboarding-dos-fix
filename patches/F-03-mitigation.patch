+package com.android.settings.onboarding.tasks
+
+import android.os.Binder
+import java.time.Duration
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+
+class DiagnosisProviderTask(
+    private val callingUid: Int = Binder.getCallingUid(),
+    private val delayFor: Duration = Duration.ZERO
+) {
+    companion object {
+        private const val MAX_DELAY_MILLIS = 60_000L // Upper bound 60s
+        private const val MAX_CONCURRENT_PER_UID = 5
+        private val activeTasksByUid = ConcurrentHashMap<Int, AtomicInteger>()
+    }
+
+    fun runTask() {
+        val counter = activeTasksByUid.computeIfAbsent(callingUid) { AtomicInteger(0) }
+        if (counter.get() >= MAX_CONCURRENT_PER_UID) {
+            throw IllegalStateException("Concurrent task quota exceeded for UID: $callingUid")
+        }
+
+        counter.incrementAndGet()
+        try {
+            val clampedDelay = delayFor.toMillis().coerceIn(0L, MAX_DELAY_MILLIS)
+            // Eksekusi diagnosis dengan delay yang aman
+        } finally {
+            counter.decrementAndGet()
+        }
+    }
+}
